{
  "name": "fitness-and-tracking",
  "version": "1.0.0",
  "description": "Fitness & Tracking Web App — Nutrition, Workout Planning & Progress Analytics",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "npm --workspace=server run dev",
    "dev:web": "npm --workspace=web run dev",
    "start": "npm --workspace=server run start",
    "test": "npm --workspace=server test",
    "build": "npm --workspace=web run build"
  }
}
